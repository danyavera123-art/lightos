# Загрузчик (нужен установщику для записи на диск)
# Метапакеты grub-pc и grub-efi-amd64 конфликтуют между собой —
# ставим -bin версии (не конфликтуют, а grub-install/grub-mkconfig приходят с grub2-common)
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
os-prober
parted
gdisk
dosfstools

# Прошивки Wi-Fi/звук/видео
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros

# Broadcom BCM4313/4321 (ноутбуки HP/Lenovo/Dell 2009-2012):
# открытый b43 эти чипы НЕ поддерживает (в b43_bcma_tbl нет core id 0x13),
# поэтому нужен проприетарный broadcom-sta (пакет wl) + dkms для сборки модуля.
# Прошивки лежат внутри пакета broadcom-sta-dkms, firmware-brcm80211 тут не поможет.
dkms
broadcom-sta-dkms
linux-headers-amd64