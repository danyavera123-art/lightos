# Драйверы видеокарт (без них система падает на vesa — очень медленно)
# radeon обязателен для Radeon HD 54xx (Park/Cedar) — это rebadge чипа Cedar,
# amdgpu его НЕ поддерживает (ищет прошивку PITCAIRN, которой нет)
xserver-xorg-video-radeon
xserver-xorg-video-amdgpu
xserver-xorg-video-intel
xserver-xorg-video-nouveau

# Прошивки AMD (CEDAR_* нужны radeon для Park; PALADIN для новых карт)
firmware-amd-graphics

# Проверка графики: glxinfo, glxgears — нужны пользователю для диагностики
mesa-utils
mesa-va-drivers
mesa-vdpau-drivers

# Дисплейный менеджер
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings

# Сеть
network-manager

# Звук
pulseaudio
pavucontrol
alsa-utils
