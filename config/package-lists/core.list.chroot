# LightOS — ядро и базовая система
#
# initramfs-tools обязан быть ЯВНЫМ пунктом списка, а не приходить
# авто-зависимостью live-boot: иначе `apt-get autoremove` на этапе
# установки (lightos-install-post.sh) удалит его вместе с initrd,
# и установленная система не загрузится. Держим его руками.
linux-image-amd64
initramfs-tools
initramfs-tools-core
locales
sudo
policykit-1
dbus

# Графический стек (Xorg)
xserver-xorg-core
xserver-xorg-input-all
xserver-xorg-input-libinput
xserver-xorg-video-vesa
xserver-xorg-video-fbdev
xinit

# Драйверы видеокарт (без них система падает на vesa — очень медленно)
# radeon обязателен для Radeon HD 54xx (Park/Cedar) — это rebadge чипа Cedar,
# amdgpu его НЕ поддерживает (ищет прошивку PITCAIRN, которой нет)
xserver-xorg-video-radeon
xserver-xorg-video-amdgpu
xserver-xorg-video-intel
xserver-xorg-video-nouveau

# Прошивки AMD (CEDAR_* нужны radeon для Park; PALADIN для новых карт)
firmware-amd-graphics

# Проверка графики: glxinfo, glxgears — нужны пользователю для диагностики
mesa-utils
mesa-va-drivers
mesa-vdpau-drivers

# Дисплейный менеджер
lightdm
lightdm-gtk-greeter
lightdm-gtk-greeter-settings

# Сеть
network-manager

# Звук
pulseaudio
pavucontrol
alsa-utils
pulseaudio-module-bluetooth

# Bluetooth
bluez
bluez-tools

# Файловые системы и диски
gvfs
gvfs-backends
gvfs-fuse
udisks2
exfatprogs
ntfs-3g

# Утилиты
curl
wget
gpg
rsync
ca-certificates
bash-completion
xdg-utils
xdg-user-dirs
htop
neofetch
yad
file

# Сжатие ОЗУ (важно для 4 ГБ)
zram-tools

# Загрузчик (нужен установщику для записи на диск)
# Метапакеты grub-pc и grub-efi-amd64 конфликтуют между собой —
# ставим -bin версии (не конфликтуют, а grub-install/grub-mkconfig приходят с grub2-common)
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
os-prober
parted
gdisk
dosfstools

# Прошивки Wi-Fi/звук/видео
firmware-linux
firmware-iwlwifi
firmware-realtek
firmware-atheros

# Прошивки Broadcom — открытый драйвер b43
firmware-brcm80211

# Broadcom BCM4313/4321/4322/4325 (ноутбуки HP/Lenovo/Dell 2009-2012)
# СПЕЦИАЛЬНО НЕ ВХОДЯТ В ОБРАЗ:
#   * broadcom-sta-dkms + dkms — тянут за собой linux-headers и сборку
#     модуля на КАЖДУЮ сборку, даже там, где Broadcom нет вообще.
#     Это заметная доля размера образа, а на неподдерживаемом ядре
#     DKMS падает и ломает всю сборку.
#   * linux-headers-amd64 (мета-пакет, ~500 МБ) — не обязан совпадать
#     с текущим ядром, из-за чего dkms не мог пересобрать модуль после
#     обновления ядра. Нужные заголовки ставятся точно под `uname -r`.
#
# Что происходит вместо этого: lightos-drivers читает PCI ID адаптера и,
# если Broadcom ИМЕННО из неподдерживаемых моделей b43, ставит
# broadcom-sta-dkms + linux-headers-$(uname -r) и собирает модуль wl
# уже на живой системе, с blacklist b43. На остальных Broadcom ставится
# открытый b43 без DKMS.
#
# Подробности: usr/bin/lightos-drivers.sh, detect_wifi() и секция DKMS.