#!/bin/bash
# LightOS: установка собственных скриптов в /usr/local/lib/lightos,
# чтобы их можно было обновлять по кнопке без переустановки ISO.
set -e

LIB="/usr/local/lib/lightos"
mkdir -p "$LIB/bin"

# --- Версия -----------------------------------------------------------------
# Берём из /etc/lightos-build-version, куда build.sh кладёт значение
# из файла VERSION в корне репозитория. Захардкоженная версия здесь
# расходилась с тегом релиза в CI (ISO v1.0.5 внутри себя считал себя
# 1.0.0, и свежеустановленная система сразу предлагала обновление).
VERSION="0.0.0"
if [ -f /etc/lightos-build-version ]; then
  VERSION="$(tr -d '[:space:]' < /etc/lightos-build-version)"
fi
if [ "$VERSION" = "0.0.0" ]; then
  echo "lightos: ВНИМАНИЕ — /etc/lightos-build-version отсутствует, версия 0.0.0"
fi
printf '%s\n' "$VERSION" > "$LIB/VERSION"
printf '%s\n' "$VERSION" > /etc/lightos-version

# --- Скрипты ----------------------------------------------------------------
# includes.chroot мог не примениться до срабатывания хука — тогда скриптов
# не будет и кнопка обновления окажется бесполезной. Это не молчаливый
# провал: предупреждаем в лог сборки.
COPIED=0
for f in /usr/bin/lightos-*.sh; do
  [ -f "$f" ] || continue
  cp -a "$f" "$LIB/bin/$(basename "$f")"
  COPIED=$((COPIED + 1))
done
chmod 0755 "$LIB"/bin/*.sh 2>/dev/null || true

if [ "$COPIED" -eq 0 ]; then
  echo "lightos: ВНИМАНИЕ — не найдено ни одного /usr/bin/lightos-*.sh"
  echo "lightos: includes.chroot/usr/bin не применился, кнопка обновления не будет работать"
fi

# --- Живой симлинк в PATH ----------------------------------------------------
# Симлинк, а не копия: lightos-update.sh после распаковки заменяет его
# обычным файлом, и тогда lightos-appcenter и ярлыки продолжают работать.
# install-* в PATH не кладём: их зовёт Calamares по абсолютному пути, а руками
# запускать их на работающей системе нельзя.
for f in "$LIB"/bin/*.sh; do
  [ -f "$f" ] || continue
  name=$(basename "$f" .sh)
  case "$name" in lightos-install-copy|lightos-install-post) continue ;; esac
  ln -sf "$f" "/usr/local/bin/$name"
done

# --- Ярлыки ------------------------------------------------------------------
# Единственный источник — includes.chroot/usr/share/applications: там лежат
# lightos-appcenter/drivers/perf/update/installer.desktop, и они уже попали
# в /usr/share/applications самим live-build. Раньше эти же файлы были
# продублированы здесь и в make-update-payload.sh — три копии, и правку
# Exec приходилось повторять вручную в каждой.
chmod 0644 /usr/share/applications/lightos-*.desktop 2>/dev/null || true
update-desktop-database /usr/share/applications 2>/dev/null || true

# --- Настройки по умолчанию для новых пользователей -------------------------
# Композитор выключен — это главный тормоз на Intel GMA / Radeon Cedar.
if [ -d /etc/skel/.config ]; then
  mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
  cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="use_compositing" type="bool" value="false"/>
    <property name="animations" type="string" value="none"/>
    <property name="show_shadow" type="bool" value="false"/>
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
  </property>
  <property name="animations" type="string" value="none"/>
  <property name="box" type="empty"/>
</channel>
EOF
  chown -R lightos:lightos /etc/skel/.config 2>/dev/null || true
fi

# --- DKMS --------------------------------------------------------------------
# Собираем модули только если они реально есть. Раньше здесь стоял безусловный
# `dkms autoinstall`, который сыпал ошибками на каждой машине без Broadcom
# (broadcom-sta-dkms стоит в core.list.chroot всем подряд).
if command -v dkms >/dev/null 2>&1 && dkms status 2>/dev/null | grep -q '^[^ ]*,[^ ]*,[^ ]*,installed$'; then
  echo "==> Сборка DKMS-модулей..."
  dkms autoinstall || echo "    (dkms не смог собрать модули — починит lightos-drivers)"
else
  echo "==> Активных DKMS-модулей нет — сборка не требуется"
fi

# --- Broadcom ----------------------------------------------------------------
# ВАЖНО: blacklist b43 НЕ пишется здесь. Раньше он создавался в образе
# безусловно, для всех машин, и ломал Wi-Fi на чипах, где открытый b43
# работает отлично: lightos-drivers ставил firmware-brcm80211, но b43 уже
# был заблокирован, а wl (broadcom-sta) часто не собирается на новых ядрах.
# Итог был один — Wi-Fi не работал вообще.
# Blacklist теперь пишет lightos-drivers и ТОЛЬКО для чипов, которым
# broadcom-sta действительно нужен (BCM4313/4321/4322/4325).
exit 0
