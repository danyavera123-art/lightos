#!/bin/bash
# LightOS: установка собственных скриптов в /usr/local/lib/lightos,
# чтобы их можно было обновлять по кнопке без переустановки ISO.
set -e

LIB="/usr/local/lib/lightos"
mkdir -p "$LIB/bin"

# Копируем скрипты из /usr/bin (их положил includes.chroot) в LIB
COPIED=0
for f in /usr/bin/lightos-*.sh; do
  [ -f "$f" ] || continue
  cp -a "$f" "$LIB/bin/$(basename "$f")"
  COPIED=$((COPIED + 1))
done
chmod 0755 "$LIB"/bin/*.sh 2>/dev/null || true

# includes.chroot может не попасть в chroot до срабатывания хука —
# тогда скриптов не будет и кнопка обновления окажется бесполезной.
# Это не молчаливый провал: предупреждаем в лог сборки.
if [ "$COPIED" -eq 0 ]; then
  echo "lightos: ВНИМАНИЕ — не найдено ни одного /usr/bin/lightos-*.sh"
  echo "lightos: includes.chroot/usr/bin не применился, кнопка обновления не будет работать"
fi

# Версия. Меняйте её при выпуске нового релиза — она попадёт в ISO
# и в /usr/local/lib/lightos/VERSION, и по ней работает --check.
VERSION="1.0.0"
printf '%s\n' "$VERSION" > "$LIB/VERSION"
printf '%s\n' "$VERSION" > /etc/lightos-version

# Симлинки в PATH: /usr/bin/lightos-drivers -> /usr/local/lib/lightos/bin/lightos-drivers.sh
for f in "$LIB"/bin/*.sh; do
  [ -f "$f" ] || continue
  name=$(basename "$f" .sh)
  ln -sf "$f" "/usr/local/bin/$name"
done

# Иконки и ярлыки
mkdir -p /usr/share/applications

cat > /usr/share/applications/lightos-drivers.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Драйверы
Comment=Найти и поставить драйверы видеокарты, Wi-Fi и звука
Exec=x-terminal-emulator -e sudo lightos-drivers
Icon=lightos-logo
Terminal=false
Categories=System;
EOF

cat > /usr/share/applications/lightos-perf.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Оптимизация системы
Comment=Отключить композитор и анимации — ускорить систему
Exec=xfce4-terminal --title="Оптимизация LightOS" --maximize --command="lightos-perf.sh"
Icon=lightos-logo
Terminal=false
Categories=System;
EOF

cat > /usr/share/applications/lightos-update.desktop <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Обновить LightOS
Comment=Обновить LightOS через интернет, без флешки и без другого компьютера
Exec=xfce4-terminal --title="Обновление LightOS" --maximize --command="sudo lightos-update.sh"
Icon=lightos-logo
Terminal=false
Categories=System;
EOF

chmod 0644 /usr/share/applications/lightos-*.desktop

update-desktop-database /usr/share/applications 2>/dev/null || true

# Настройки оптимизации по умолчанию для НОВЫХ пользователей
# (композитор выключен — это главный тормоз на Intel GMA / Radeon Cedar)
if [ -d /etc/skel/.config ]; then
  mkdir -p /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml
  cat > /etc/skel/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="animations" type="empty">
    <value type="string" value="none"/>
  </property>
  <property name="box" type="empty"/>
  <property name="compositor" type="empty"/>
  <property name="general" type="empty">
    <property name="show_frame_shadow" type="bool" value="false"/>
    <property name="show_popup_shadow" type="bool" value="false"/>
    <property name="use_compositing" type="bool" value="false"/>
  </property>
</channel>
EOF
  chown -R lightos:lightos /etc/skel/.config 2>/dev/null || true
fi

# --- Сборка DKMS-модулей (broadcom-sta) -----------------------------------
if command -v dkms >/dev/null; then
  echo "==> Сборка DKMS-модулей..."
  dkms autoinstall || echo "    (dkms не смог собрать модули — проверим в lightos-drivers)"
fi

# blacklists для broadcom-sta: b43/bcma мешают модулю wl
mkdir -p /etc/modprobe.d
cat > /etc/modprobe.d/blacklist-broadcom-sta.conf <<'EOF'
# Broadcom BCM4313/4321 не поддерживается открытым b43 (нет core id 0x13 в
# b43_bcma_tbl) — работает только проприетарный broadcom-sta (wl).
# b43/bcma нужно убрать, иначе wl не загрузится.
blacklist b43
blacklist b43legacy
blacklist bcma
blacklist bcma-hci
EOF

exit 0